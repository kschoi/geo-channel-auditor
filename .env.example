# Liner Platform API 키 (https://platform.liner.com 에서 발급)
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 .gitignore 에 포함되어 커밋되지 않습니다.
LINER_API_KEY=

# (선택) Liner API 엔드포인트 / 타임아웃
# LINER_API_BASE_URL=https://platform.liner.com/api/v1
# LINER_TIMEOUT_SECONDS=45

# (선택) 데모 모드에서 단계별 진행을 보여주기 위한 인위적 지연(ms). 0이면 지연 없음.
# DEMO_LATENCY_MS=380
